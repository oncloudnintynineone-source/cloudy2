# --- Database (Neon Postgres) ---
# Neon connection string, e.g. postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev only — leave UNSET on Vercel (it injects VERCEL_URL; an empty value
# breaks prerender with "TypeError: Invalid URL"). On Cloud Run set it to the
# service's *.run.app URL (no VERCEL_URL fallback exists there).
NEXTAUTH_URL=http://localhost:3000

# --- Google Cloud (Service Account) ---
# Base64-encoded service account JSON key (single env var keeps Vercel secret management simple)
GOOGLE_SERVICE_ACCOUNT_BASE64=
# Fallback: individual fields (used only if BASE64 is empty)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The Workspace account that Gmail send (KAH breach emails) impersonates via domain-wide
# delegation — grant the service account the gmail.send scope for it in the Workspace
# admin console; also receives owner ACL grants on department calendars.
# Leave empty when using SMTP_URL instead.
GOOGLE_DELEGATE_EMAIL=

# --- Notification email transport (KAH breach emails) ---
# SMTP fallback when there is no Workspace domain-wide delegation, e.g. a personal
# Gmail account with an app password (2-Step Verification → App passwords):
#   SMTP_URL=smtp://you%40gmail.com:THE16CHARAPPPASSWORD@smtp.gmail.com:465
# URL-encode special characters in user/pass; smtps:/port 465 = implicit TLS.
SMTP_URL= 

# --- Web Push (event participant notifications) ---
# Users are notified (browser push) when they are added as participants to an
# event. Generate the key pair ONCE with: npx web-push generate-vapid-keys
# The public key is inlined into the client (NEXT_PUBLIC_...) and read by the
# server at runtime; VAPID_PRIVATE_KEY is server-only. The same pair is shared
# across environments (they identify the app server, not an environment) —
# mirror all three to Vercel prod/preview and the Cloud Run shadow.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: (or https:) contact identifying the app to the push service.
# Without all three vars push is skipped gracefully (no notifications sent).
VAPID_SUBJECT=mailto:cloudy2@example.com

# --- App settings (bootstrap secrets, configured via env only) ---
# Emergency (break-glass) root password. Bcrypt-hashed into
# settings.admin_password_hash on first run; reconciled on every login, so
# changing the env var + redeploying rotates the stored hash. Sign in on the
# Admin surface with the phone field left blank. Leave blank to disable.
ADMIN_INITIAL_PASSWORD=password
# Shared sign-in PIN for every user with the Admin role (named admins sign in
# with their phone + this PIN on the Admin surface). Bcrypt-hashed into
# settings.admin_pin_hash on first run; reconciled on every login exactly like
# ADMIN_INITIAL_PASSWORD. There is no in-app way to set or change it.
ADMIN_PIN=
