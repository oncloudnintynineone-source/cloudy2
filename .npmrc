# Resilient installs on slow/throttled registries (local dev, CI, and the Cloud
# Run Docker build all read this). Layout-affecting settings are intentionally
# NOT set here — the repo keeps pnpm's default isolated node_modules, and the
# Dockerfile copies the full tree for `next start`.
network-concurrency=8
fetch-retries=6
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=600000
